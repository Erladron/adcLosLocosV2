    .popover-content {
      background: #0d327c !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      border-radius: 16px !important;
      padding: 8px !important;
      overflow: visible !important;
    }

    ion-datetime {
      --background: #0d327c !important;
      --background-nested: #0a255c !important;
      background: #0d327c !important;
      border-radius: 12px;
      color: #ffffff !important;

      /* Forzar textos legibles */
      .calendar-day,
      .time-picker-item,
      .wheel-item,
      .picker-opt {
        color: #ffffff !important;
      }

      .wheel-item-active,
      .picker-opt-selected,
      .calendar-day-active {
        color: #38bdf8 !important;
        font-weight: bold !important;
      }

      /* Botones Aceptar / Cancelar inferior */
      .datetime-buttons {
        ion-button {
          --color: #38bdf8 !important;
          font-weight: bold;
        }
      }
    }
  }
}

/* 🎨 ESTILOS PARA EL MODAL DE FECHAS */
ion-modal.peña-datetime-modal {
  --background: #0d327c !important;
  --border-radius: 20px 20px 0 0;
  --handle-background: #38bdf8;

  ion-content.modal-datetime-content {
    --background: #0d327c !important;
  }

  .modal-datetime-container {
    padding: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0d327c;
    min-height: 100%;
  }

  ion-datetime.custom-peña-datetime {
    --background: #0d327c !important;
    --background-nested: #0a255c !important;
    background: #0d327c !important;
    border-radius: 16px;
    color: #ffffff !important;
    width: 100%;
    max-width: 350px;
    margin: 0 auto;

    /* Estilos internos para los textos y ruedas */
    ::ng-deep {
      .calendar-day, 
      .time-picker-item, 
      .wheel-item, 
      .picker-opt {
        color: #ffffff !important;
      }

      .wheel-item-active, 
      .picker-opt-selected, 
      .calendar-day-active {
        color: #38bdf8 !important;
        font-weight: bold !important;
      }

      .wheel-highlight {
        background: rgba(56, 189, 248, 0.25) !important;
      }

      .datetime-buttons {
        ion-button {
          --color: #38bdf8 !important;
          font-weight: 700;
        }
      }
    }
  }
}

.peña-custom-input.clickable {
  cursor: pointer;
  
  input {
    cursor: pointer;
  }
