<file path="projects/web-onboarding/src/app/pages/welcome/welcome.page.scss">
// Contenedor principal a pantalla completa con fondo gris claro
.welcome-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background-color: #f4f6f9;
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  padding: 20px;
}

// Tarjeta corporativa flotante
.welcome-card {
  width: 100%;
  max-width: 480px;
  background-color: #ffffff;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

// Cabecera azul profundo con degradado idéntico al del mail
.card-header {
  background: linear-gradient(135deg, #18366b 0%, #224d96 100%);
  padding: 35px 20px;
  text-align: center;
  color: #ffffff;

  .logo-container {
    margin-bottom: 12px;
    
    .club-logo {
      width: 90px;
      height: auto;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.15));
    }
  }

  h1 {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    letter-spacing: 1px;
  }

  .slogan {
    font-size: 13px;
    color: #93c5fd;
    margin: 6px 0 0 0;
    font-style: italic;
    font-weight: 500;
  }
}

// Zona de contenido
.card-content {
  padding: 40px 30px;
  text-align: center;
}

// Cajas de estado
.status-box {
  display: flex;
  flex-direction: column;
  align-items: center;

  h3 {
    font-size: 20px;
    color: #1e293b;
    margin-top: 0;
    margin-bottom: 12px;
    font-weight: 700;
  }

  p {
    font-size: 15px;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }
}

// Estado: Cargando
.loading-box {
  p { margin-top: 15px; font-weight: 500; }
  .sub-text { font-size: 13px; color: #94a3b8; margin-top: 5px; }
  
  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #f1f5f9;
    border-top-color: #1c3f7c;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
}

// Estado: Éxito
.success-box {
  .welcome-text {
    margin-bottom: 30px;
  }

  // Botón Corporativo Premium
  .btn-primary {
    background-color: #1c3f7c;
    color: #ffffff;
    border: none;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(28, 63, 124, 0.2);
    transition: all 0.2s ease-in-out;

    &:hover {
      background-color: #15305e;
      transform: translateY(-1px);
      box-shadow: 0 6px 15px rgba(28, 63, 124, 0.3);
    }

    &:active {
      transform: translateY(1px);
    }
  }
}

// Estado: Error
.error-box {
  .error-icon {
    font-size: 36px;
    margin-bottom: 10px;
  }
  .error-text { color: #e11d48; font-weight: 500; margin-bottom: 15px; }
  .help-text { font-size: 13px; color: #94a3b8; line-height: 1.5; }
}

// Pie de tarjeta
.card-footer {
  padding: 15px 20px;
  background-color: #f8fafc;
  border-top: 1px solid #f1f5f9;
  text-align: center;
  
  p {
    margin: 0;
    font-size: 11px;
    color: #94a3b8;
  }
}

// Animación del Spinner
@keyframes spin {
  to { transform: rotate(360deg); }
}
