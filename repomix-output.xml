<div class="section-card" *ngIf="!mostrarCropper" data-cy="personal-data-card">
  <div class="header-main-row">
    <div class="profile-header">
      <div class="avatar-container circular-profile">
        <img *ngIf="user?.foto" [src]="user.foto" class="profile-avatar" data-cy="profile-avatar-img" />
        <div *ngIf="!user?.foto" class="default-avatar">
          <ion-icon name="person-outline"></ion-icon>
        </div>
      </div>
      <div class="user-details">
        <h2 data-cy="profile-display-name">{{ user?.nombre || 'Nuevo Usuario' }}</h2>
        <p>Datos personales.</p>
      </div>
    </div>

    <div *ngIf="!simpleMode && isEditMode && canEdit && !editing" class="header-edit-btn">
      <ion-button class="section-action-btn" shape="round" (click)="toggleEdit.emit()" data-cy="btn-profile-edit-toggle">
        <ion-icon slot="icon-only" name="create-outline"></ion-icon>
      </ion-button>
    </div>
  </div>

  <div class="edit-mode-panel" *ngIf="!isEditMode || editing">
    <div class="edit-panel-left">
      <ion-button class="photo-btn" shape="round" (click)="selectPhoto.emit()" data-cy="btn-profile-gallery">
        <ion-icon slot="icon-only" name="images-outline"></ion-icon>
      </ion-button>
      <ion-button class="photo-btn" shape="round" (click)="takePhoto.emit()" data-cy="btn-profile-camera">
        <ion-icon slot="icon-only" name="camera-outline"></ion-icon>
      </ion-button>
    </div>
    
    <div class="edit-panel-right" *ngIf="isEditMode">
      <ion-button class="action-btn-glass cancel" shape="round" (click)="cancelEdit.emit()" data-cy="btn-profile-cancel">
        <ion-icon slot="icon-only" name="close-outline"></ion-icon>
      </ion-button>
      <ion-button class="action-btn-glass apply" shape="round" (click)="toggleEdit.emit()" data-cy="btn-profile-save">
        <ion-icon slot="icon-only" name="save-outline"></ion-icon>
      </ion-button>
    </div>
  </div>

  <div class="form-fields">
    
    <ion-item class="custom-item">
      <ion-label position="stacked">Nombre y Apellidos *</ion-label>
      <ion-input [(ngModel)]="user.nombre" (ionChange)="onCapitalizeName()" [readonly]="!canEdit || (isEditMode && !editing)" data-cy="input-profile-nombre"></ion-input>
    </ion-item>

    <ion-item class="custom-item" *ngIf="isPortero && (!isEditMode || editing || user.empresa)">
      <ion-label position="stacked">Empresa de Seguridad *</ion-label>
      <ion-input [(ngModel)]="user.empresa" placeholder="Ej. Prosegur, Securitas..." [readonly]="!canEdit || (isEditMode && !editing)" data-cy="input-profile-empresa"></ion-input>
      <ion-icon slot="start" name="shield-checkmark-outline" style="color: #38bdf8; margin-top: 24px;"></ion-icon>
    </ion-item>

    <ion-item class="custom-item" *ngIf="user.telefono || !isEditMode || editing">
      <ion-label position="stacked">Teléfono</ion-label>
      <ion-input type="tel" maxlength="9" [(ngModel)]="user.telefono" [readonly]="!canEdit || (isEditMode && !editing)" data-cy="input-profile-telefono"></ion-input>
    </ion-item>

    <ion-item class="custom-item" *ngIf="user.dni || !isEditMode || editing">
      <ion-label position="stacked">DNI</ion-label>
      <ion-input 
        inputmode="numeric" 
        [maxlength]="isReadonlyMode ? 9 : 8" 
        [ngModel]="dniParaMostrar" 
        (ngModelChange)="onDniChange($event)" 
        [readonly]="isReadonlyMode"
        placeholder="Ej. 12345678"
        data-cy="input-profile-dni">
      </ion-input>
      <div slot="end" class="dni-badge" *ngIf="letraDni && !isReadonlyMode" data-cy="profile-dni-letter-badge">
        - {{ letraDni }}
      </div>
    </ion-item>
    
    <div class="dni-helper" *ngIf="editing || !isEditMode">
      <ion-icon name="information-circle-outline"></ion-icon>
      <span>Introduce solo los 8 números. La letra se añade automáticamente.</span>
    </div>

    <ng-container *ngIf="!isPortero">
      <div class="direccion-container" *ngIf="user.direccion || !isEditMode || editing">
        <ion-item class="custom-item">
          <ion-label position="stacked">Dirección Postal</ion-label>
          <ion-input 
            [(ngModel)]="user.direccion" 
            (ngModelChange)="onDireccionChange($event)"
            (ionBlur)="ocultarSugerencias()"
            placeholder="Calle, número o localidad" 
            [readonly]="!canEdit || (isEditMode && !editing)"
            data-cy="input-profile-direccion">
          </ion-input>
        </ion-item>
        
        @if (mostrarSugerencias && sugerencias.length > 0) {
          <ion-list class="mapbox-suggestions" data-cy="profile-address-suggestions">
            @for (sug of sugerencias; track sug.id || sug.name) {
              <ion-item button (mousedown)="$event.preventDefault()" (click)="seleccionarDireccion(sug)" data-cy="profile-address-suggestion-item">
                <ion-label>
                  <h2 class="sug-title">{{ sug.name }}</h2>
                  <p class="sug-subtitle">{{ sug.place_formatted }}</p>
