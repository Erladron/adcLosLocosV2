  }

  .slogan {
    font-size: 13px;
    color: #93c5fd;
    margin: 6px 0 0 0;
    font-style: italic;
    font-weight: 500;
  }
}

// Zona de contenido
.card-content {
  padding: 35px 30px 40px 30px;
  text-align: center;
}

// Cajas de estado / Títulos internos
.status-box {
  display: flex;
  flex-direction: column;
  align-items: center;

  h3 {
    font-size: 22px;
    color: #1c3f7c;
    margin-top: 0;
    margin-bottom: 6px;
    font-weight: 700;
  }
}

// Pie de tarjeta
.card-footer {
  padding: 15px 20px;
  background-color: #f8fafc;
  border-top: 1px solid #f1f5f9;
  text-align: center;
  
  p {
    margin: 0;
    font-size: 11px;
    color: #94a3b8;
  }
}


// ==========================================
// 2. ESTILOS ESPECÍFICOS DEL FORMULARIO
// ==========================================

// Subtítulo explicativo del email
.subtitle-text {
  font-size: 14px;
  color: #64748b;
  margin-top: 0;
  margin-bottom: 25px;
  line-height: 1.4;
  
  strong { 
    color: #1c3f7c; 
    font-weight: 600;
  }
}

// Contenedor del formulario
.register-form {
  width: 100%;
  text-align: left;
}

// Bloques contenedores de inputs de texto
.input-group-box {
  margin-bottom: 18px;
  display: flex;
  flex-direction: column;

  label {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    margin-bottom: 6px;
    letter-spacing: 0.3px;
  }

  .input-field-wrapper {
    position: relative;
    display: flex;
    align-items: center;

    input {
      width: 100%;
      padding: 12px 45px 12px 16px; // Más espacio a la derecha por el botón del ojo
      font-size: 14px;
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      color: #1e293b;
      background-color: #f8fafc;
      transition: all 0.2s ease-in-out;

      &:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #1c3f7c;
        box-shadow: 0 0 0 3px rgba(28, 63, 124, 0.1);
      }

      &::placeholder {
        color: #94a3b8;
      }
    }

    // Botón transparente para mostrar/ocultar clave
    .btn-toggle-eye {
      position: absolute;
      right: 12px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 16px;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
      
      &:hover {
        transform: scale(1.1);
      }
    }
  }
}

// Bloque de información y texto legal (Sustituto del checkbox)
.legal-info-text {
  font-size: 12px;
  color: #64748b;
  line-height: 1.5;
  text-align: center;
  margin-top: 5px;
  margin-bottom: 25px;

  .legal-link {
    color: #1c3f7c;
    text-decoration: underline;
    font-weight: 500;
    transition: color 0.2s ease;
    
    &:hover {
      color: #2563eb;
    }
  }
}

// Mensajes de alerta en color rojo para validaciones
.error-msg-text {
  font-size: 12px;
  color: #e11d48;
  font-weight: 500;
  margin-top: 5px;
  padding-left: 2px;
}

// Botón de acción Corporativo Premium
.btn-primary {
  background-color: #1c3f7c;
  color: #ffffff;
  border: none;
  padding: 14px 32px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 12px rgba(28, 63, 124, 0.2);
  transition: all 0.2s ease-in-out;

  &:hover:not(:disabled) {
    background-color: #15305e;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(28, 63, 124, 0.3);
  }

  &:active:not(:disabled) {
    transform: translateY(1px);
  }
}

// Modificador del botón para hacerlo expandible al 100%
.full-width-btn {
  width: 100%;
  display: block;
  text-align: center;

  &:disabled {
    background-color: #94a3b8 !important;
    cursor: not-allowed;
    box-shadow: none !important;
    transform: none !important;
    opacity: 0.7;
  }
}
</file>

