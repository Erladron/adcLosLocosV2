<file path="src/app/features/events/pages/event-guests/event-guests.page.scss">
/* ==========================================================================
   PAGE STRUCT & GLASS CHASSIS
   ========================================================================= */
.home-content {
  --background: linear-gradient(180deg, #123d92 0%, #0d327c 100%) !important;
  position: relative;
  
  .background-logo {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    opacity: 0.04;
    z-index: 0;
    
    .small-escudo-bg { width: 80%; max-width: 340px; }
  }
}

.home-container { position: relative; z-index: 2; padding: 16px 14px 60px; }

/* ==========================================================================
   CARDS CRISTALINAS (GLASSMORPHISM DE LA PEÑA)
   ========================================================================== */
.glass-card {
  background: rgba(255, 255, 255, 0.08) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  border-radius: 20px !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25) !important;
  color: #ffffff !important;
  margin-bottom: 18px;
}

/* RESUMEN DEL EVENTO SUPERIOR */
.event-info-summary {
  padding: 16px;

  .badge-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    color: #ffb703;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    
    .amber-glow { filter: drop-shadow(0 0 4px rgba(255, 183, 3, 0.4)); }
  }

  .summary-title { font-size: 19px; font-weight: 800; margin: 6px 0 4px 0; color: #ffffff; }
  .summary-subtitle {
    margin: 0; font-size: 12px; color: rgba(255, 255, 255, 0.5);
    display: flex; align-items: center; gap: 4px;
    ion-icon { font-size: 14px; }
    strong { color: #38bdf8; }
  }
}

/* TARJETA DE OPERACIONES CRISTAL CORPO */
.operations-card {
  padding: 20px !important;

  .quota-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 12px;
    margin-bottom: 14px;

    .quota-label { font-size: 11px; font-weight: 800; color: rgba(255, 255, 255, 0.4); letter-spacing: 0.5px; }
    .quota-value {
      font-size: 14px; font-weight: 900; color: #4ade80;
      &.quota-limit { color: #f87171 !important; }
    }
  }

  .section-instruction-text { font-size: 12.5px; color: rgba(255,255,255,0.6); margin: 0 0 10px 0; line-height: 1.4; }
}

/* ==========================================================================
   AUTOCOMPLETADO MOTOR (ESTILO FIEL CASINO / FERIA)
   ========================================================================== */
.autocomplete-wrapper {
  position: relative;
  margin-bottom: 14px;

  .search-input-box {
    display: flex;
    align-items: center;
    background: rgba(13, 50, 124, 0.4) !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-radius: 12px;
    padding: 0 14px;
    height: 46px;

    .search-icon { color: rgba(255, 255, 255, 0.4); font-size: 19px; margin-right: 10px; }
    .clear-icon { color: rgba(255, 255, 255, 0.4); font-size: 19px; margin-left: 10px; cursor: pointer; }
    
    input {
      flex: 1; background: transparent; border: none; color: #ffffff; font-size: 14px; outline: none;
      &::placeholder { color: rgba(255, 255, 255, 0.3) !important; }
    }
  }

  .autocomplete-dropdown {
    position: absolute;
    top: 100%; left: 0; right: 0;
    background: #102654 !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 12px; margin: 6px 0 0 0; padding: 0; list-style: none;
    max-height: 190px; overflow-y: auto; z-index: 1000;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);

    li {
      padding: 12px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer;
      transition: background 0.2s ease;
      
      &:last-child { border-bottom: none; }
      &:active { background: rgba(56, 189, 248, 0.2) !important; }

      .dropdown-user-info {
        display: flex; flex-direction: column;
        .dropdown-name { font-size: 14px; font-weight: 700; color: #ffffff; }
        .dropdown-dni { font-size: 11px; color: rgba(255, 255, 255, 0.4); margin-top: 2px; }
      }
    }
  }
}

/* BOTÓN EMISIÓN ACCESO PEÑA */
.peña-action-btn-submit {
  width: 100%; height: 46px; border-radius: 30px; font-size: 14px; font-weight: 700;
  background: #2dd36f; color: #070d19; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(45, 211, 111, 0.25);
  transition: all 0.2s ease;

  &:disabled {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    color: rgba(255, 255, 255, 0.2) !important;
    box-shadow: none !important; cursor: not-allowed;
  }
  &:active:not(:disabled) { transform: scale(0.98); }
}

/* WARNING DE EXCESO DE CUPO */
.warning-card-alert {
  display: flex; align-items: center; gap: 10px;
  background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25);
  padding: 14px 16px; border-radius: 12px; margin-top: 4px;
  
  ion-icon { font-size: 24px; color: #f87171; flex-shrink: 0; }
  p { margin: 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.8); font-weight: 600; line-height: 1.4; }
}

/* ==========================================================================
   TABLA ESTRUCTURADA DE INVITADOS EMITIDOS
   ========================================================================== */
.invited-guests-section {
  margin-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 18px;

  .table-title {
    margin: 0 0 12px 0; font-size: 11px; font-weight: 800;
    color: rgba(255, 255, 255, 0.4); text-transform: uppercase; letter-spacing: 0.5px;
  }

  .invited-guests-table {
    display: flex; flex-direction: column; gap: 8px;

    .table-row {
      display: flex; align-items: center;
      background: rgba(0, 0, 0, 0.22) !important;
      border: 1px solid rgba(255, 255, 255, 0.05) !important;
      border-radius: 10px; padding: 10px 14px;

      .row-index { font-size: 12px; font-weight: 900; color: rgba(255, 255, 255, 0.25); width: 28px; }
      
      .row-details {
        flex: 1; display: flex; flex-direction: column;
        .guest-name { font-size: 14px; font-weight: 700; color: #ffffff; }
        .guest-status { font-size: 10px; color: #4ade80; margin-top: 1px; font-weight: 700; letter-spacing: 0.3px; }
      }

      .btn-delete-pass {
        background: transparent; border: none; color: #f87171; font-size: 19px;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        padding: 6px; margin-left: 6px; border-radius: 50%;
        transition: background 0.2s ease, transform 0.1s;

        &:active { background: rgba(248, 113, 113, 0.15); transform: scale(0.92); }
      }
    }
  }
}
