<file path="src/app/features/users/pages/gest-user/gest-user.page.html">
<app-page-header title="Gestión de Usuarios" [showMenu]="true" [showBack]="true" data-cy="page-header"></app-page-header>

<ion-content class="users-content ion-padding" data-cy="gest-user-content">
  <!-- Logo de fondo -->
  <div class="background-logo">
    <img src="assets/img/escudo.png" alt="Logo de fondo" />
  </div>

  <!-- Buscador -->
  <div class="search-container">
    <ion-searchbar class="custom-searchbar" [(ngModel)]="searchText" (ionInput)="filterUsers()"
      placeholder="Buscar por nombre, nº socio o teléfono..." debounce="200" animated="true"
      data-cy="searchbar-users"></ion-searchbar>
  </div>

  <!-- Segmentos de filtrado por pestañas -->
  <div class="users-segment-wrapper">
    <div class="user-segment">
      <ion-segment class="users-segment" [(ngModel)]="tabActual">
        <ion-segment-button value="activos" data-cy="segment-activos">
          <ion-label>ACTIVOS ({{ filteredUsers.length }})</ion-label>
        </ion-segment-button>

        <ion-segment-button *ngIf="canApproveUsers" value="pendientes" data-cy="segment-pendientes">
          <ion-label>PENDIENTES ({{ filteredPendingUsers.length }})</ion-label>
        </ion-segment-button>

        <ion-segment-button *ngIf="canViewInactiveUsers" value="inactivos" data-cy="segment-inactivos">
          <ion-label>INACTIVOS ({{ filteredInactiveUsers.length }})</ion-label>
        </ion-segment-button>
      </ion-segment>
    </div>
  </div>

  <!-- PESTAÑA: ACTIVOS -->
  <ng-container *ngIf="tabActual === 'activos'">
    <app-empty-state *ngIf="visibleUsers.length === 0" icon="people-outline" title="No se encontraron socios"
      message="Prueba a cambiar el filtro de búsqueda." data-cy="empty-state-users"></app-empty-state>

    <div *ngIf="visibleUsers.length > 0" class="users-container">
      <div *ngFor="let user of visibleUsers" class="user-card" (click)="router.navigate(['/user-detail', user.id])"
        data-cy="user-card-activo">
        <!-- Avatar -->
        <div class="user-avatar-container">
          <img *ngIf="user.foto" [src]="user.foto" [alt]="user.nombre" class="user-avatar" />
          <div *ngIf="!user.foto" class="default-avatar">
            <ion-icon name="person-outline"></ion-icon>
          </div>
        </div>

        <!-- Columna Izquierda: Identidad y Datos -->
        <div class="user-info-mini">
          <div class="user-header">
            <h2>{{ user.nombre }}</h2>
            <span class="role-pill" [ngClass]="'rol-' + getRolAbreviado(user.tipo).toLowerCase()"
              data-cy="user-card-role-badge">
              {{ getRolAbreviado(user.tipo) }}
            </span>
          </div>

          <div class="user-subinfo">
            <span *ngIf="user.numeroSocio" class="meta-item socio-item">
              <ion-icon name="card-outline"></ion-icon>
              <span class="meta-text">Nº {{ user.numeroSocio }}</span>
            </span>

            <span *ngIf="user.telefono" class="meta-item telefono-item">
              <ion-icon name="call-outline"></ion-icon>
              <span class="meta-text">{{ user.telefono }}</span>
            </span>
            <span *ngIf="!user.telefono" class="meta-item privado-item">
              <ion-icon name="eye-off-outline"></ion-icon>
              <span class="meta-text sub-italic">Privado</span>
            </span>
          </div>

          <div *ngIf="user.invitedByName" class="invite-meta">
            Invitado por: <strong>{{ user.invitedByName }}</strong>
          </div>
        </div>

        <!-- Columna Derecha: Estados y Acciones -->
        <div class="user-status-col">
          <div class="status-stack">
            <span class="account-badge active" data-cy="user-account-badge">
              Activo
            </span>

            <span *ngIf="user.tipo === 'socio' || user.tipo === 'directiva'" class="fee-substatus" [class.paid]="user.cuotaAlCorriente"
              [class.pending]="!user.cuotaAlCorriente" data-cy="user-card-fee-badge">
              <span class="status-dot"></span>
              <span>{{ user.cuotaAlCorriente ? 'Al corriente' : 'Cuota pend.' }}</span>
            </span>
          </div>

          <ion-icon name="chevron-forward-outline" class="action-chevron"></ion-icon>
        </div>
      </div>
    </div>
  </ng-container>

  <!-- PESTAÑA: PENDIENTES -->
  <ng-container *ngIf="tabActual === 'pendientes'">
    <app-empty-state *ngIf="visiblePendingUsers.length === 0" icon="people-outline"
      title="No hay solicitudes pendientes" message="No existen altas pendientes de aprobación."
      data-cy="empty-state-pending"></app-empty-state>

    <div *ngIf="visiblePendingUsers.length > 0" class="users-container">
      <div *ngFor="let user of visiblePendingUsers" class="user-card pending-card"
        (click)="router.navigate(['/user-detail', user.id])" data-cy="user-card-item-pending">
        <div class="user-avatar-container">
          <img *ngIf="user.foto" [src]="user.foto" [alt]="user.nombre" class="user-avatar" />
          <div *ngIf="!user.foto" class="default-avatar">
            <ion-icon name="person-outline"></ion-icon>
          </div>
        </div>

        <div class="user-info-mini">
          <div class="user-header">
            <h2>{{ user.nombre }}</h2>
            <span class="role-pill" [ngClass]="'rol-' + getRolAbreviado(user.tipo).toLowerCase()" data-cy="user-role-badge">
              {{ getRolAbreviado(user.tipo) }}
            </span>
          </div>

          <div class="user-subinfo">
            <span *ngIf="user.telefono" class="meta-item telefono-item">
              <ion-icon name="call-outline"></ion-icon>
              <span class="meta-text">{{ user.telefono }}</span>
            </span>
            <span *ngIf="user.profesion" class="meta-item profesion-item">
              <ion-icon name="briefcase-outline"></ion-icon>
              <span class="meta-text">{{ user.profesion }}</span>
            </span>
          </div>
        </div>

        <div class="user-status-col">
          <div class="approval-actions" (click)="$event.stopPropagation()">
            <button class="action-btn approve-btn" (click)="aprobarUsuario(user)" title="Aprobar socio">
              <ion-icon name="checkmark-outline"></ion-icon>
            </button>
            <button class="action-btn reject-btn" (click)="rechazarUsuario(user)" title="Rechazar socio">
              <ion-icon name="close-outline"></ion-icon>
            </button>
          </div>
          <ion-icon name="chevron-forward-outline" class="action-chevron"></ion-icon>
        </div>
      </div>
    </div>
  </ng-container>

  <!-- PESTAÑA: INACTIVOS -->
  <ng-container *ngIf="tabActual === 'inactivos'">
    <app-empty-state *ngIf="visibleInactiveUsers.length === 0" icon="people-outline" title="No hay usuarios inactivos"
      message="No existen registros de baja." data-cy="empty-state-inactive"></app-empty-state>

    <div *ngIf="visibleInactiveUsers.length > 0" class="users-container">
      <div *ngFor="let user of visibleInactiveUsers" class="user-card"
        (click)="router.navigate(['/user-detail', user.id])" data-cy="user-card-item-inactive">
        <div class="user-avatar-container">
          <img *ngIf="user.foto" [src]="user.foto" [alt]="user.nombre" class="user-avatar" />
          <div *ngIf="!user.foto" class="default-avatar">
            <ion-icon name="person-outline"></ion-icon>
          </div>
        </div>

        <div class="user-info-mini">
          <div class="user-header">
            <h2>{{ user.nombre }}</h2>
            <span class="role-pill" [ngClass]="'rol-' + getRolAbreviado(user.tipo).toLowerCase()" data-cy="user-role-badge">
              {{ getRolAbreviado(user.tipo) }}
            </span>
          </div>

          <div class="user-subinfo">
            <span *ngIf="user.numeroSocio" class="meta-item socio-item">
              <ion-icon name="card-outline"></ion-icon>
              <span class="meta-text">Nº {{ user.numeroSocio }}</span>
            </span>
            <span *ngIf="user.telefono" class="meta-item telefono-item">
              <ion-icon name="call-outline"></ion-icon>
              <span class="meta-text">{{ user.telefono }}</span>
            </span>
          </div>
        </div>

        <div class="user-status-col">
          <div class="status-stack">
            <span class="account-badge inactive" data-cy="user-account-badge">
              Inactivo
            </span>
          </div>
          <ion-icon name="chevron-forward-outline" class="action-chevron"></ion-icon>
        </div>
      </div>
    </div>
  </ng-container>

  <!-- Infinite Scroll -->
  <ion-infinite-scroll [disabled]="isScrollDisabled()" (ionInfinite)="cargarMasUsuarios($event)">
    <ion-infinite-scroll-content loadingSpinner="bubbles" loadingText="Cargando más usuarios...">
    </ion-infinite-scroll-content>
  </ion-infinite-scroll>

  <!-- FAB -->
  <ion-fab *ngIf="canAddUsers" vertical="bottom" horizontal="end" slot="fixed" class="fab-safe-area">
    <ion-fab-button (click)="nuevoUsuario()" color="secondary" data-cy="add-user-fab">
      <ion-icon name="add-outline"></ion-icon>
    </ion-fab-button>
  </ion-fab>
</ion-content>
</file>

