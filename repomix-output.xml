<file path="src/app/features/users/pages/gest-user/gest-user.page.scss">
/* =========================================
   CONTENEDOR DE PÁGINA Y FONDO
========================================= */
.users-content {
  --background: linear-gradient(180deg, #123d92 0%, #0d327c 100%);
  position: relative;
}

/* Logo Marca de Agua */
.background-logo {
  position: fixed;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
  opacity: 0.06;
  z-index: 0;

  img {
    width: 75%;
    max-width: 450px;
  }
}

/* =========================================
   BUSCADOR (SEARCHBAR)
========================================= */
.search-container {
  margin-bottom: 8px;

  .custom-searchbar {
    --background: rgba(255, 255, 255, 0.12);
    --border-radius: 16px;
    --box-shadow: none;
    --placeholder-color: rgba(255, 255, 255, 0.65);
    --color: #ffffff;
    --icon-color: #ffffff;
    --clear-button-color: #ffffff;
    backdrop-filter: blur(10px);
    padding: 0;
  }
}

/* =========================================
   SEGMENTOS (PESTAÑAS)
========================================= */
.users-segment-wrapper {
  margin-bottom: 16px;

  .users-segment {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;

    ion-segment-button {
      --color: rgba(255, 255, 255, 0.6);
      --color-checked: #ffffff;
      --indicator-color: #1f7cff;
      min-height: 42px;
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.3px;
    }
  }
}

/* =========================================
   CONTENEDOR Y TARJETAS DE USUARIO
========================================= */
.users-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 80px;
}

.user-card {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16px);
  border-radius: 16px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: background-color 0.2s ease, transform 0.15s ease;

  &:active {
    transform: scale(0.99);
    background: rgba(255, 255, 255, 0.16);
  }

  &.pending-card {
    border-left: 4px solid #f59e0b;
  }
}

/* Avatar */
.user-avatar-container {
  width: 48px;
  height: 48px;
  flex-shrink: 0;

  .user-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .default-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.15);

    ion-icon {
      font-size: 1.4rem;
      color: rgba(255, 255, 255, 0.7);
    }
  }
}

/* =========================================
   PILLS DE ROL (JERARQUÍA VISUAL REMARCADA)
========================================= */
.role-pill {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  font-size: 0.65rem !important;
  font-weight: 800 !important;
  letter-spacing: 0.5px;
  padding: 3px 8px !important;
  border-radius: 6px !important;
  text-transform: uppercase;
  flex-shrink: 0;
  line-height: 1 !important;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  margin-left: 6px;

  /* 1. ADMINISTRADOR: Rojo Carmesí */
  &.rol-adm {
    background-color: #dc2626 !important;
    color: #ffffff !important;
    border: 1px solid #f87171 !important;
  }

  /* 2. DIRECTIVA: Naranja / Dorado Potente */
  &.rol-dir {
    background-color: #d97706 !important;
    color: #ffffff !important;
    border: 1px solid #fbbf24 !important;
  }

  /* 3. SOCIO: Azul Cyan Eléctrico */
  &.rol-soc {
    background-color: #0284c7 !important;
    color: #ffffff !important;
    border: 1px solid #38bdf8 !important;
  }

  /* 4. INVITADO: Verde Esmeralda */
  &.rol-inv {
    background-color: #059669 !important;
    color: #ffffff !important;
    border: 1px solid #34d399 !important;
  }

  /* 5. PORTERO: Gris Pizarra */
  &.rol-por {
    background-color: #475569 !important;
    color: #e2e8f0 !important;
    border: 1px solid #94a3b8 !important;
  }
}

/* =========================================
   COLUMNA IZQUIERDA: INFORMACIÓN
========================================= */
.user-info-mini {
  flex: 1;
  min-width: 0;

  .user-header {
    display: flex;
    align-items: center;
    gap: 8px;

    h2 {
      margin: 0;
      font-size: 0.92rem;
      font-weight: 700;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .user-subinfo {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;

    .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 0.73rem;
      color: rgba(255, 255, 255, 0.75);

      ion-icon {
        font-size: 0.8rem;
        color: #64b5f6;
      }

      .sub-italic {
        font-style: italic;
        opacity: 0.7;
      }
    }
  }

  .invite-meta {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 3px;

    strong {
      color: rgba(255, 255, 255, 0.85);
    }
  }
}

/* =========================================
   COLUMNA DERECHA: ESTADOS Y ACCIONES
========================================= */
.user-status-col {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;

  .status-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }

  .account-badge {
    font-size: 0.62rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 10px;

    &.active {
      background: rgba(16, 185, 129, 0.18);
      color: #34d399;
      border: 1px solid rgba(52, 211, 153, 0.3);
    }

    &.inactive {
      background: rgba(239, 68, 68, 0.18);
      color: #f87171;
      border: 1px solid rgba(248, 113, 113, 0.3);
    }
  }

  .fee-substatus {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.62rem;

    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
    }

    &.paid {
      color: rgba(255, 255, 255, 0.6);

      .status-dot {
        background-color: #10b981;
      }
    }

    &.pending {
      color: #fb7185;
      font-weight: 600;

      .status-dot {
        background-color: #f43f5e;
        box-shadow: 0 0 4px rgba(244, 63, 94, 0.6);
      }
    }
  }

  .approval-actions {
    display: flex;
    gap: 6px;

    .action-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;

      ion-icon {
        font-size: 1rem;
        color: #ffffff;
      }

      &.approve-btn {
        background: #10b981;
      }

      &.reject-btn {
        background: #ef4444;
      }
    }
  }

  .action-chevron {
    color: rgba(255, 255, 255, 0.3);
    font-size: 1.05rem;
  }
}

/* FAB */
ion-fab-button {
  --background: linear-gradient(135deg, #2f7cff, #1f5edb);
  --box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
}
