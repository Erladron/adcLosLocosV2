  gap: 12px;
  width: 100%;
  margin-bottom: 20px;
}

// Botón base estilo App Store / Google Play
.btn-store {
  display: flex;
  align-items: center;
  background-color: #0f172a; // Negro pizarra muy elegante
  color: #ffffff;
  text-decoration: none;
  padding: 10px 20px;
  border-radius: 8px;
  transition: all 0.2s ease-in-out;
  text-align: left;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.15);

  &:hover {
    background-color: #1e293b;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(15, 23, 42, 0.25);
  }

  .icon {
    font-size: 24px;
    margin-right: 14px;
    display: flex;
    align-items: center;
  }

  .btn-text {
    display: flex;
    flex-direction: column;

    small {
      font-size: 9px;
      font-weight: 500;
      color: #94a3b8;
      letter-spacing: 0.5px;
    }

    strong {
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }
  }
}

// Enlace sutil para volver atrás
.btn-back-link {
  background: none;
  border: none;
  color: #64748b;
  font-size: 13px;
  font-weight: 500;
  text-decoration: underline;
  cursor: pointer;
  margin-top: 10px;
  transition: color 0.2s ease;

  &:hover {
    color: #1c3f7c;
  }
}

// Animación de entrada
@keyframes popIn {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
