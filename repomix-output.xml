  left: 0;
  right: 0;
  background: rgba(13, 50, 124, 0.95) !important;
  border: 1px solid rgba(255, 255, 255, 0.15) !important;
  border-radius: 12px;
  margin-top: 4px;
  max-height: 220px;
  overflow-y: auto;
  z-index: 9999 !important;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  padding: 0;
}

// Clase unificada invisible para quitar el fondo de los interruptores
.peña-toggle-transparent {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 10px 0px;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;

  ion-label {
    font-size: 14px;
    font-weight: 600;
    color: #cbd5e1;
    letter-spacing: 0.3px;
  }

  ion-toggle {
    margin: 0;
    padding: 0;
  }
}

/* 🎨 CORRECCIÓN DE VISIBILIDAD Y TAMAÑO PARA EL POPOVER DEL CALENDARIO */
ion-popover.peña-datetime-popover {
  --background: #0d327c !important;
  --backdrop-opacity: 0.6;
  --width: 320px;
  --max-width: 90vw;
  --border-radius: 16px;
  --box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);

  /* Aseguramos que el contenido dentro del popover no se colapse */
